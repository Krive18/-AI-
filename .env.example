# Local development configuration only. Do not use these values in production.
APP_ENV=local
APP_NAME=LinguaSphere API
DATABASE_URL=mysql+asyncmy://ai_translation_app:local-app-password@127.0.0.1:3306/ai_translation
REDIS_URL=redis://127.0.0.1:6379/0
# Redis 3.2 local compatibility only. Production must use RESP3 with Redis 7.2+.
REDIS_PROTOCOL=2
SESSION_COOKIE_SECURE=false
SESSION_HASH_KEY=local-development-session-hash-key-change-before-deployment
# 32-byte URL-safe base64 AES-GCM key for local provider credential encryption only.
PROVIDER_SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
PRIVATE_STORAGE_ROOT=.ai_translation_private
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=1800
# 并发槽数：每个槽会占用 CPU 跑 FFmpeg，按机器核数调整。
WORKER_MAX_CONCURRENCY=2
