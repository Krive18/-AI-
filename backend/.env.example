# ===== 运行环境 =====
# local / test / production
APP_ENV=production
APP_NAME=LinguaSphere API

# ===== 数据库与缓存 =====
# MySQL 8.0+，建议专用最小权限账号（见 migrations/sql 下的权限模板）
DATABASE_URL=mysql+asyncmy://ai_translation_app:改成强密码@127.0.0.1:3306/ai_translation?charset=utf8mb4
# 生产必须 Redis 7.2+（RESP3），启用认证与持久化
REDIS_URL=redis://:改成Redis密码@127.0.0.1:6379/0
REDIS_PROTOCOL=3

# ===== 会话安全（production 强制）=====
# 两个值必须保持 __Host- 前缀且 SESSION_COOKIE_SECURE=true（要求 HTTPS）
SESSION_COOKIE_NAME=__Host-ai_translation_session
ADMIN_SESSION_COOKIE_NAME=__Host-ai_translation_admin_session
SESSION_COOKIE_SECURE=true
# 至少 32 字节的随机串：python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_HASH_KEY=改成至少32字节随机串
# base64 编码的 32 字节随机密钥：python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PROVIDER_SECRET_ENCRYPTION_KEY=改成base64的32字节密钥

# ===== 跨域 =====
# 前端与 API 同域部署（配置了 FRONTEND_DIST 由本服务托管页面）时留空即可；
# 前端单独部署在其它域名时，必须填前端来源（JSON 数组，不允许 *）
ALLOWED_ORIGINS=[]

# ===== 前端静态资源 =====
# 指向前端打包产物（npm run build 生成的 dist），设置后由本服务直接托管页面
FRONTEND_DIST=../frontend/dist

# ===== 文件存储 =====
# 私有存储根目录（源视频、成片、字幕），确保磁盘空间充足且不可公网访问
PRIVATE_STORAGE_ROOT=./data/private

# ===== Worker =====
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=1800
# 同时处理的翻译任务数（1-8），按服务器 CPU/内存调整
WORKER_MAX_CONCURRENCY=2
